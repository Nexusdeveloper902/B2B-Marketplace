# syntax=docker/dockerfile:1

# Presence Platform — Marketplace Storefront
# Vercel Container Deployment target (FrankenPHP).
#
# This Dockerfile uses FrankenPHP (Vercel's officially recommended PHP runtime)
# instead of Apache+mod_php. FrankenPHP is a single binary that combines a
# Caddy web server and the PHP runtime, reads OS environment variables natively
# (no SetEnv/PassEnv needed), and requires no vhost port templating.
#
# Previous attempts (RUN-005 through RUN-009) used php:apache + mod_php.
# That approach failed because:
#   1. The php:apache image does NOT pass OS env vars to PHP by default
#      (requires SetEnv directives that were never added)
#   2. Apache's Listen directive can't read $PORT at parse time
#   3. The entrypoint's .env materialization failed on Vercel's read-only FS
#   4. The config-level is_writable() fallback returned true for root
#      even on read-only filesystem layers
#
# FrankenPHP eliminates all of these issues. See:
#   - .agent/DECISIONS/ADR-011-switch-to-frankenphp.md
#   - .agent/OBSERVATIONS/OBS-012-apache-mod-php-env-var-passing.md
#   - Vercel's official PHP guide: vercel.com/kb/guide/deploy-php-on-vercel-with-docker
#   - FrankenPHP Laravel docs: frankenphp.dev/docs/laravel
#
# vercel.json declares this as a container service:
#   {
#     "services": {
#       "api": { "root": ".", "entrypoint": "Dockerfile.vercel", "runtime": "container" }
#     },
#     "rewrites": [{ "source": "/(.*)", "destination": { "service": "api" } }]
#   }
#
# Build locally for testing:
#   docker build -f Dockerfile.vercel -t storefront-vercel .
#   docker run --rm -p 8080:8080 -e PORT=8080 storefront-vercel

ARG PHP_VERSION=8.4

# ---------------------------------------------------------------------------
# Stage 1 — PHP dependencies.
# ---------------------------------------------------------------------------
FROM composer:2 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install \
        --no-dev \
        --no-scripts \
        --no-autoloader \
        --prefer-dist \
        --no-interaction \
        --no-progress

COPY . .
RUN composer dump-autoload --optimize --no-interaction

# ---------------------------------------------------------------------------
# Stage 2 — Runtime (FrankenPHP).
#
# dunglas/frankenphp:1-php8.4 bundles:
#   - FrankenPHP (Go-based PHP app server)
#   - Caddy (web server)
#   - PHP 8.4 with all standard extensions
#   - install-php-extension-installer script
#
# FrankenPHP reads env vars natively (unlike Apache+mod_php), binds to $PORT
# via Caddyfile config, and serves PHP directly without mod_php or FastCGI.
# ---------------------------------------------------------------------------
FROM dunglas/frankenphp:1-php${PHP_VERSION}

# Install the PHP extensions this app needs. FrankenPHP's base image ships
# most extensions; pdo_sqlite and sqlite3 are needed for the contact form.
RUN install-php-extensions pdo_sqlite sqlite3 mbstring opcache

# Copy the application + vendor from stage 1.
WORKDIR /app
COPY --from=vendor --chown=www-data:www-data /app /app

# Copy the Caddyfile that configures FrankenPHP to:
#   - Listen on :{$PORT:80} (Vercel injects $PORT; default 80 for local dev)
#   - Serve /app/public as the document root
#   - Route all requests through public/index.php (Laravel's front controller)
COPY --chown=www-data:www-data docker/caddy/Caddyfile.vercel /etc/frankenphp/Caddyfile

# Copy the simplified entrypoint (no Apache port patching needed).
COPY --chmod=0755 docker/entrypoint.frankenphp.sh /usr/local/bin/storefront-entrypoint

# Ensure writable directories exist (FrankenPHP runs as www-data by default).
RUN mkdir -p /app/storage/framework/views \
             /app/storage/framework/sessions \
             /app/storage/framework/cache/data \
             /app/storage/logs \
             /app/bootstrap/cache \
    && chown -R www-data:www-data /app/storage /app/bootstrap/cache

EXPOSE 80

# Prepares writable directories, creates the SQLite file, generates APP_KEY
# if missing, runs migrations, then execs frankenphp.
ENTRYPOINT ["storefront-entrypoint"]
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
