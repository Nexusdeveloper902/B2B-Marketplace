# Version control and agent memory never enter the image.
.git
.gitignore
.gitattributes
.agent

# Development-only files (tests run on a dev machine, not in the container).
.editorconfig
phpunit.xml
.phpunit.result.cache
tests/

# Docker build files themselves are not needed inside the image
# (docker/ stays: stage 2 copies the entrypoint and configs from it).
# This .dockerignore is shared by BOTH images (the Vercel `Dockerfile`
# and the Render `Dockerfile.render`); each one's own Dockerfile name
# and the other's variant files are excluded so neither image carries
# stale deployment-target files in its /var/www/html.
Dockerfile
Dockerfile.render
docker-compose.yml

# Host build artifacts — regenerated inside stage 1.
vendor/

# Runtime state must not leak into the image.
database/database.sqlite
storage/framework/sessions/*
storage/framework/views/*
storage/framework/cache/data/*
storage/logs/*
bootstrap/cache/packages.php
bootstrap/cache/services.php
